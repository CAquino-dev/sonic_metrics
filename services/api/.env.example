APP_NAME=Sonic Metrics
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://sonic_metrics:sonic_metrics_dev@127.0.0.1:5432/sonic_metrics
JWT_SECRET_KEY=replace-with-a-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback
LASTFM_API_KEY=
REDIS_URL=redis://127.0.0.1:6379/0

# Lifetimes in seconds; maximum age includes the fresh window.
CACHE_PROFILE_FRESH_SECONDS=3600
CACHE_PROFILE_MAX_AGE_SECONDS=86400
CACHE_TOP_FRESH_SECONDS=3600
CACHE_TOP_MAX_AGE_SECONDS=86400
CACHE_RECENT_FRESH_SECONDS=120
CACHE_RECENT_MAX_AGE_SECONDS=900
CACHE_PLAYER_FRESH_SECONDS=10
CACHE_PLAYER_MAX_AGE_SECONDS=30
CACHE_ARTIST_FRESH_SECONDS=3600
CACHE_ARTIST_MAX_AGE_SECONDS=86400
CACHE_TAGS_FRESH_SECONDS=86400
CACHE_TAGS_MAX_AGE_SECONDS=604800
